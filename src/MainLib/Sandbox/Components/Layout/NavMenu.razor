@rendermode InteractiveServer
@inject AppConfiguration AppConfig

<FluentNav @ref="@nav" Id="main-menu" Width="260px" UseSingleExpanded="true">
    @if (AppConfig.IsDevelopment && showDev)
    {
        <FluentNavItem Href="design" IconRest="@((new Icons.Regular.Size20.DesignIdeas()))">Design</FluentNavItem>
    } 

    <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())" IconActive="@(new Icons.Filled.Size20.Home())">Home</FluentNavItem>

    <FluentNavCategory Id="maps" Title="Maps" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="maps-basic" IconRest="@((new Icons.Regular.Size20.Map()))">Basic</FluentNavItem>
        <FluentNavItem Href="maps-layers" IconRest="@((new Icons.Regular.Size20.LayerDiagonal()))">Layers</FluentNavItem>
        <FluentNavItem Href="maps-multiple" IconRest="@((new Icons.Regular.Size20.Map()))">Multiple</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Events" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavItem Href="events-map" IconRest="@((new Icons.Regular.Size20.MapPin()))">Map</FluentNavItem>
        <FluentNavItem Href="events-layer" IconRest="@((new Icons.Regular.Size20.MapPin()))">Layer</FluentNavItem>
        <FluentNavItem Href="events-marker" IconRest="@((new Icons.Regular.Size20.MapPin()))">Marker</FluentNavItem>
    </FluentNavCategory>

    <FluentNavCategory Title="Modules" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">
        <FluentNavSectionHeader Title="Data" />
        <FluentNavItem Href="tests-bbox" IconRest="@(new Icons.Regular.Size20.DesignIdeas())">BoundingBox</FluentNavItem>
        <FluentNavItem Href="tests-mercator-point" IconRest="@(new Icons.Regular.Size20.DesignIdeas())">MercatorPoint</FluentNavItem>
        <FluentNavItem Href="tests-position" IconRest="@(new Icons.Regular.Size20.DesignIdeas())">Position</FluentNavItem>

        <FluentNavSectionHeader Title="General" />
        <FluentNavItem Href="tests-math" IconRest="@(new Icons.Regular.Size20.DesignIdeas())">Math</FluentNavItem>
    </FluentNavCategory>
</FluentNav>

@code {
    FluentNav nav = default!;
    private bool showDev = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await nav.ExpandCategoryAsync("maps");
        }
    }
}
