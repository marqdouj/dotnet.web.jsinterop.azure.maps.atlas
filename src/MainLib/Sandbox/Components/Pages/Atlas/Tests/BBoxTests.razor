@page "/tests-bbox"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ILogger<BBoxTests> Logger
@inject INotificationService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>@title</PageTitle>

<FluentStack Orientation="Orientation.Vertical">
    <Toolbar>
        <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.Run())" Title="Run Tests" OnClick="@RunTests" />
    </Toolbar>

    <div style="overflow:auto;height:100%">
        <FluentDataGrid Items="@testRuns.AsQueryable()"
                        MultiLine="true"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky">
            <PropertyColumn Property="@(p => p.Name)" />
            <PropertyColumn Property="@(p => p.Status)" />
            <PropertyColumn Property="@(p => p.Result)" />
            <PropertyColumn Property="@(p => p.Error)"/>
        </FluentDataGrid>
    </div>
</FluentStack>

@code {
    private const string sourceUrl = "https://learn.microsoft.com/en-us/javascript/api/azure-maps-control/atlas.data.boundingbox?view=azure-maps-typescript-latest";
    private const string name = "BoundingBox";
    private string title => $"atlas.data.{name}";
    private IAtlasInterop? maps;
    private bool mapReady => maps != null;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private List<MathTestRun> testRuns = [];
    private readonly BoundingBox bbox = TestData.BBox;
    private readonly Polygon poly = TestData.Poly;

    protected override void OnInitialized()
    {
        maps = new AtlasInterop(JSRuntime);
        //TestData.WriteNamesToConsole(typeof(IAtlasBoundingBox));
    }

    #region Math Tests

    private async Task RunTests()
    {
        try
        {
            ShowOverlay(true);

            var tests = new List<MathTestRun>();

            tests.Add(await ContainsPositionTest());
            tests.Add(await CrossesAntimeridianTest());
            tests.Add(await FromBoundingBoxTest());
            tests.Add(await FromDataTest());
            tests.Add(await FromDimensionsTest());
            tests.Add(await FromEdgesTest());
            tests.Add(await FromLatLngsTest());
            tests.Add(await FromPositionsTest());
            tests.Add(await GetCenterTest());
            tests.Add(await GetEastTest());
            tests.Add(await GetHeightTest());
            tests.Add(await GetNorthTest());
            tests.Add(await GetNorthEastTest());
            tests.Add(await GetNorthWestTest());
            tests.Add(await GetSouthTest());
            tests.Add(await GetSouthEastTest());
            tests.Add(await GetSouthWestTest());
            tests.Add(await GetWestTest());
            tests.Add(await GetWidthTest());
            tests.Add(await IntersectTest());
            tests.Add(await MergeTest());
            tests.Add(await SplitOnAntimeridianTest());


            testRuns = tests;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    private async Task<MathTestRun> ContainsPositionTest()
    {
        var result = new MathTestRun(nameof(ContainsPositionTest));

        try
        {
            var data = await maps!.Data.BoundingBox.ContainsPosition(bbox, bbox.Northeast!);
            result.Status = data ? MathTestRunStatus.Success : MathTestRunStatus.Failed;
        }
        catch (Exception ex)
        {
            result.Status = MathTestRunStatus.Failed;
            result.Exception = ex;
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }

        return result;
    }

    private async Task<MathTestRun> CrossesAntimeridianTest()
    {
        var result = new MathTestRun(nameof(CrossesAntimeridianTest));

        try
        {
