@page "/tests-math"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ILogger<MathTests> Logger
@inject INotificationService ToastService
@inject IJSRuntime JSRuntime

<FluentStack Orientation="Orientation.Vertical">
    <Toolbar>
        <FluentButton Disabled="@buttonsDisabled" IconStart="@(new Icons.Regular.Size20.Run())" Title="Run Tests" OnClick="@RunTests" />
    </Toolbar>

    <div style="overflow:auto;height:100%">
        <FluentDataGrid Items="@testRuns.AsQueryable()"
                        MultiLine="true"
                        GenerateHeader="DataGridGeneratedHeaderType.Sticky">
            <PropertyColumn Property="@(p => p.Name)" />
            <PropertyColumn Property="@(p => p.Status)" />
            <PropertyColumn Property="@(p => p.Result)" />
            <PropertyColumn Property="@(p => p.Error)"/>
        </FluentDataGrid>
    </div>
</FluentStack>

@code {
    private const string sourceUrl = "https://learn.microsoft.com/en-us/javascript/api/azure-maps-control/atlas.math?view=azure-maps-typescript-latest";
    private const string name = "Math";
    private string title => $"Atlas - {name}";
    private string mapId = $"mapMath";
    private IAtlasInterop? maps;
    private bool mapReady => maps != null;
    private bool mapNotReady => !mapReady;
    private bool overlay;
    private bool buttonsDisabled => mapNotReady | overlay;
    private List<MathTestRun> testRuns = [];
    private readonly BoundingBox bbox = new BoundingBox(12.803766, 43.033716, 13.129083, 43.33345);
    private readonly Polygon poly = new Polygon(new List<Position> {
                new Position(-122.35, 47.65),
                new Position(-122.30, 47.65),
                new Position(-122.30, 47.60),
                new Position(-122.35, 47.60),
                new Position(-122.35, 47.65)
            });

    protected override void OnInitialized()
    {
        maps = new AtlasInterop(JSRuntime);
        // Type type = typeof(IAtlasMath);

        // // Retrieve all methods (public, non-public, instance, static, declared only in this class)
        // var methods = type.GetMethods(
        //     System.Reflection.BindingFlags.Public |
        //     System.Reflection.BindingFlags.NonPublic |
        //     System.Reflection.BindingFlags.Instance |
        //     System.Reflection.BindingFlags.Static |
        //     System.Reflection.BindingFlags.DeclaredOnly
        // );

        // foreach (var method in methods.OrderBy(m => m.Name))
        // {
        //     Console.WriteLine(method.Name);
        // }
    }

    #region Math Tests

    private async Task RunTests()
    {
        try
        {
            ShowOverlay(true);

            var tests = new List<MathTestRun>();

            tests.Add(await BoundingBoxToPolygonTest());
            tests.Add(await ConvertAccelerationTest());
            tests.Add(await ConvertAreaTest());
            tests.Add(await ConvertDistanceTest());
            tests.Add(await ConvertSpeedTest());
            tests.Add(await ConvertTimeSpanTest());
            tests.Add(await GetAccelerationTest());
            tests.Add(await GetAccelerationFromFeaturesTest());
            tests.Add(await GetAccelerationFromSpeedsTest());
            tests.Add(await GetAffineTransformToSourceTest());
            tests.Add(await GetAffineTransformToTargetTest());
            tests.Add(await GetAreaTest());
            tests.Add(await GetCardinalSplineTest());
            tests.Add(await GetClosestPointOnGeometryTest());
            tests.Add(await GetConvexHullTest());
            tests.Add(await GetDestinationTest());
            tests.Add(await GetDistanceToTest());
            tests.Add(await GetEarthRadiusTest());
            tests.Add(await GetGeodesicPathTest());
            tests.Add(await GetGeodesicPathsTest());
            tests.Add(await GetHeadingTest());
            tests.Add(await GetLengthOfPathTest());
            tests.Add(await GetPathDenormalizedAtAntimerianTest());
            tests.Add(await GetPathSplitByAntimeridianTest());
            tests.Add(await GetPixelHeadingTest());
            tests.Add(await GetPointsWithHeadingAlongPathTest());
            tests.Add(await GetPointWithHeadingAlongPathTest());
            tests.Add(await GetPositionTest());
            tests.Add(await GetPositionAlongPathTest());
            tests.Add(await GetPositionsTest());
            tests.Add(await GetPositionsAlongPathTest());
            tests.Add(await GetRegularPolygonPathTest());
            tests.Add(await GetRegularPolygonPathsTest());
            tests.Add(await GetSpeedTest());
            tests.Add(await GetSpeedFromFeaturesTest());
            tests.Add(await GetTravelDistanceTest());
            tests.Add(await InterpolateTest());
            tests.Add(await MercatorPixelsToPositionsTest());
            tests.Add(await MercatorPositionsToPixelsTest());
            tests.Add(await NormalizeLatitudeTest());
            tests.Add(await NormalizeLongitudeTest());
            tests.Add(await RotatePositionsTest());
            tests.Add(await SimplifyPixelsTest());
            tests.Add(await SimplifyPositionsTest());

            testRuns = tests;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            ShowOverlay(false);
        }
    }

    private async Task<MathTestRun> BoundingBoxToPolygonTest()
    {
        var result = new MathTestRun(nameof(BoundingBoxToPolygonTest));

        try
        {
            var bboxes = new List<BoundingBox> { bbox };
            var data = await maps!.Math.BoundingBoxToPolygon(bboxes);
            result.Status = data.Count == 1 ? MathTestRunStatus.Success : MathTestRunStatus.Failed;
        }
        catch (Exception ex)
        {
            result.Status = MathTestRunStatus.Failed;
            result.Exception = ex;
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }

        return result;
    }

