@page "/events-stylecontrol"
@rendermode InteractiveServer
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<StyleControlEvents> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates StyleControl events.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
            <FluentSpacer Width="8px" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.Eraser())" Title="Clear Events" OnClick="@(() => ClearEvents(true))" />
            <FluentCheckbox Label="Multiliine" @bind-Value="@multiline" />
        </Toolbar>

        <FluentStack>
            <FluentCard Height="@height" Width="200px" Style="overflow:auto">
                <FluentStack Orientation="Orientation.Vertical">
                    @foreach (var item in styleControlEvents)
                    {
                        <FluentCheckbox Disabled="@mapNotReady" Label="@item.Name" @bind-Value:get="@item.IsLoaded" @bind-Value:set="@((e) => OnMapEventsCheckedChanged(e, item))" />
                    }
                </FluentStack>
            </FluentCard>

            <MapContainer MapId="@mapId" />
        </FluentStack>

        <EventsViewer Events="@eventArgsManager" Maps="@atlasInterop" Mulitline="@multiline" />
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "styleControlEvents";
    private const string title = "StyleControl Events";
    private readonly string height = "300px";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private MapConfiguration? config;
    private Map? map;
    private bool mapNotReady => map == null;
    private List<StyleControlEventViewModel> styleControlEvents = [];
    private readonly MapEventArgsViewModelManager eventArgsManager = new();
    private bool multiline;
    private readonly StyleControl styleControl = new StyleControl();

    protected override void OnInitialized()
    {
        var values = Enum.GetValues<StyleControlEventType>().OrderBy(e => e.ToString()).ToList();
        styleControlEvents = values.Select(e => new StyleControlEventViewModel(new StyleControlEvent(e))).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                config = Configuration?.GetValue(LogLevel.Trace);
                atlasInterop = new(JSRuntime);
                dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

                await CreateMap();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Initialization caused an exception.");
                await ToastService.ShowError("Initialization caused an exception.");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OnMapEventsCheckedChanged(bool isChecked, StyleControlEventViewModel model)
    {
        try
        {
            if (model.IsLoaded == isChecked)
                return;

            model.StyleControlEvent.Source = styleControl.Id;

            if (isChecked)
            {
                await atlasInterop.Events.StyleControl.Add(dotNetRef!, map!, [model.StyleControlEvent]);
            }
            else
            {
                await atlasInterop.Events.StyleControl.Remove(map!, [model.StyleControlEvent]);
            }

            model.IsLoaded = isChecked;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ClearEvents(bool clearArgs)
    {
        try
        {
            if (atlasInterop == null) return;

            var items = styleControlEvents.Where(e => e.IsLoaded);

            await atlasInterop.Events.StyleControl.Remove(map!, items.Select(i => i.StyleControlEvent));

            foreach (var item in items)
                item.IsLoaded = false;

            if (clearArgs)
                eventArgsManager.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config!.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config, [styleControl]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            await ClearEvents(true);
            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);
        eventArgsManager.Add(e);
        StateHasChanged();
    }

    #endregion

    private class StyleControlEventViewModel
    {
        public StyleControlEventViewModel(StyleControlEvent mapEvent)
        {
            StyleControlEvent = mapEvent;
        }

        public StyleControlEvent StyleControlEvent { get; }
        public StyleControlEventType Type => StyleControlEvent.Type;
        public string Name => Type.ToString();
        public bool IsLoaded { get; set; }
    }
}
