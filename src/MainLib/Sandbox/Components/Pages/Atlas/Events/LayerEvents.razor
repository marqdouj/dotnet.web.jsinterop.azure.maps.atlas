@page "/events-layers"
@rendermode InteractiveServer
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<LayerEvents> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates layer events.
            <br />
            NOTE: Some events are applied only to the featues of the layer, 
            i.e. for a symbol layer the click event is fired when a symbol is clicked, not when the map itself it clicked.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
            <FluentSpacer Width="10px" />
            <FluentLabel>Layer:</FluentLabel>
            <FluentSelect Items="@layerTypes" TValue="LayerType?" TOption="LayerType?" @bind-Value:get="@selectedLayer" @bind-Value:set="@SelectedLayerChanged" Placeholder="Select a layer..." />
            <FluentSpacer Width="8px" />
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.Eraser())" Title="Clear Events" OnClick="@(() => ClearEvents(true))" />
            <FluentCheckbox Label="Multiliine" @bind-Value="@multiline" />
            <FluentCheckbox Label="Prevent Default" @bind-Value="@preventDefault" Tooltip="@preventDefaultText" />
        </Toolbar>

        <FluentStack>
            <FluentCard Height="@height" Width="200px" Style="overflow:auto">
                <FluentStack Orientation="Orientation.Vertical">
                    @foreach (var item in layerEvents)
                    {
                        <FluentCheckbox Disabled="@mapNotReady" Label="@item.Name" @bind-Value:get="@item.IsLoaded" @bind-Value:set="@((e) => OnMapEventsCheckedChanged(e, item))" />
                    }
                </FluentStack>
            </FluentCard>

            <MapContainer MapId="@mapId" />
        </FluentStack>

        <EventsViewer Events="@eventArgsManager" Maps="@atlasInterop" Mulitline="@multiline" />
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapEvents";
    private const string title = "Map Events";
    private readonly string height = "300px";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private MapConfiguration? config;
    private Map? map;
    private bool mapNotReady => map == null;
    private List<LayerEventViewModel> layerEvents = [];
    private readonly MapEventArgsViewModelManager eventArgsManager = new();
    private readonly List<LayerType?> layerTypes = Enum.GetValues<LayerType>().OrderBy(e => e.ToString()).Cast<LayerType?>().ToList();
    private bool multiline;
    private bool preventDefault = true;
    private const string preventDefaultText = "Setting will be applied when adding the event. Normally used with Mouse, Touch, and Wheel events.";
    private ILayer? activeLayer;
    private LayerType? selectedLayer;
    private MapSource? source;

    protected override void OnInitialized()
    {
        //These layers do not support the events.
        layerTypes.Remove(LayerType.HeatMap);
        layerTypes.Remove(LayerType.Image);
        layerTypes.Remove(LayerType.Tile);

        var values = Enum.GetValues<LayerEventType>().OrderBy(e => e.ToString()).ToList();
        layerEvents = values.Select(e => new LayerEventViewModel(new LayerEvent(e))).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                config = Configuration?.GetValue(LogLevel.Trace);

                atlasInterop = new(JSRuntime);
                dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

                await CreateMap();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Initialization caused an exception.");
                await ToastService.ShowError("Initialization caused an exception.");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OnMapEventsCheckedChanged(bool isChecked, LayerEventViewModel item)
    {
        try
        {
            if (activeLayer == null)
                return;

            if (item.IsLoaded == isChecked)
                return;

            if (isChecked)
            {
                item.LayerEvent.Source = activeLayer.Id;
                item.LayerEvent.PreventDefault = preventDefault;
                await atlasInterop.Events.Layers.Add(dotNetRef!, map!, [item.LayerEvent]);
            }
            else
            {
                await atlasInterop.Events.Layers.Remove(map!, [item.LayerEvent]);
            }

            item.IsLoaded = isChecked;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ClearEvents(bool clearArgs)
    {
        try
        {
            if (atlasInterop == null || activeLayer == null) return;

            var items = layerEvents.Where(e => e.IsLoaded);

            foreach (var item in items)
                item.LayerEvent.Source = activeLayer.Id;

            await atlasInterop.Events.Layers.Remove(map!, items.Select(i => i.LayerEvent));

            foreach (var item in items)
                item.IsLoaded = false;

            if (clearArgs)
                eventArgsManager.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    #region Layer

    private async Task SelectedLayerChanged(LayerType? value)
    {
        if (value == selectedLayer)
            return;

        selectedLayer = value;
        await CreateLayer();
    }

    private async Task CreateLayer()
    {
        try
        {
            if (map == null) return;

            await RemoveLayer();

            if (selectedLayer == null)
                return;

            var results = await selectedLayer.AddDefaultLayer(atlasInterop, map, DataService);
            source = results.Source;
            activeLayer = results.Layer;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveLayer()
    {
        try
        {
            if (map == null)
                return;

            if (activeLayer != null)
            {
                await ClearEvents(true);
                await atlasInterop.Layers.Remove(map, activeLayer.Id);
            }

            if (source != null)
                await atlasInterop.Sources.Remove(map, source.Id);

            source = null;
            activeLayer = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    #endregion

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config!.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            await RemoveLayer();
            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await Task.CompletedTask;
        eventArgsManager.Add(e);
        StateHasChanged();
    }

    #endregion

    private class LayerEventViewModel
    {
        public LayerEventViewModel(LayerEvent layerEvent)
        {
            LayerEvent = layerEvent;
        }

        public LayerEvent LayerEvent { get; }
        public LayerEventType Type => LayerEvent.Type;
        public string Name => Type.ToString();
        public bool IsLoaded { get; set; }
    }
}
