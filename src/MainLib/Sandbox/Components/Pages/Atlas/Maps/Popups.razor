@page "/maps-popups"
@rendermode InteractiveServer
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<Popups> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates using a popup with symbols.
            <br />
            Hover the mouse over the symbols to view its popup. 
            The default text is 'Symbol #', but there is one symbol that has a full description.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
        </Toolbar>

        <MapContainer MapId="@mapId" />
    </ChildContent>
</MapPage>

<style>
    .customInfobox {
        padding: 5px;
        border-radius: 6px;
        background-color: black;
        color: white
    }
    .name {
        font-weight: bold;
    }
</style>

@code {
    private const string mapId = "mapPopups";
    private const string title = "Maps - Popups";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration config = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions(new Position(-122.1333, 47.63), 12.5);
    private Map? map;
    private bool mapNotReady => map == null;
    private const string popupTemplate = "<div class=\"customInfobox\"><div class=\"name\">{name}</div>{description}</div>";
    private DataSource? dataSource;
    private SymbolLayer? symbolLayer;
    //Create a popup but leave it closed so we can update it and display it later.
    private readonly Popup popup = new Popup { Options = new PopupOptions { PixelOffset = new Pixel(0, -18), CloseButton = false, Content = popupTemplate } };

    protected override void OnInitialized()
    {
        config = Configuration.GetValue(LogLevel.Trace);
        atlasInterop = new(JSRuntime);
        dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CreateMap();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config?.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);

        if (e.IsReadyEvent)
        {
            try
            {
                if (map == null) return;

                var results = await LayerType.Symbol.AddDefaultLayer(atlasInterop, map, DataService);
                dataSource = (DataSource?)results.Source;
                symbolLayer = (SymbolLayer?)results.Layer;

                var p = new GeoJsonProperties { { "name", "Microsoft Building 41" }, { "description", "15571 NE 31st St, Redmond, WA 98052" }, { "color", "blue" } };
                var feature = new Feature<Point, GeoJsonProperties?>(new Point(-122.1333, 47.63), p);

                _ = await atlasInterop.Features.Add(map, dataSource!.Id, [feature]);
                _ = await atlasInterop.Popups.AddHoverPopup(map, symbolLayer!, popup, ["name", "description"]);
                await ResetMap();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, null);
                await ToastService.ShowError(ex.Message);
            }
        }
    }

    #endregion
}
