@page "/maps-basic"
@rendermode InteractiveServer
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<Basic> Logger
@inject INotificationService ToastService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates how to create/remove a map instance, and add/remove controls.
            <br />
            The map is intialized to a specific camera setting (location, zoom, style etc.).
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentLabel>Map:</FluentLabel>
            <FluentButton Disabled="@createMapDisabled" IconStart="@(new Icons.Regular.Size20.Add())" Title="Create Map" OnClick="@CreateMap" />
            <FluentButton Disabled="@removeMapDisabled" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Remove Map" OnClick="@RemoveMap" />
            <FluentSpacer Width="10px"/>
            <FluentLabel>Controls:</FluentLabel>
            <FluentButton Disabled="@addControlsDisabled" IconStart="@(new Icons.Regular.Size20.Add())" Title="Add Controls" OnClick="@AddControls" />
            <FluentButton Disabled="@removeControlsDisabled" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Remove Controls" OnClick="@RemoveControls" />
            <FluentButton Disabled="@removeControlsDisabled" IconStart="@(new Icons.Regular.Size20.DeleteArrowBack())" Title="Remove Controls By Reference" OnClick="@RemoveControls" />
        </Toolbar>

        <MapContainer MapId="@mapId" />
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapBasic";
    private const string title = "Map - Basic";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration? config;
    private Map? map;
    private bool hasInterop => atlasInterop != null;
    private bool createMapDisabled => !hasInterop || map != null;
    private bool removeMapDisabled => !hasInterop || map == null;
    private List<ControlBase>? addedControls;
    private bool addControlsDisabled => !hasInterop || addedControls != null || map == null;
    private bool removeControlsDisabled => !hasInterop || addedControls == null || map == null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                config = Configuration?.Value ?? throw new Exception($"Injection of {nameof(MapConfiguration)} returned null.");

                atlasInterop = new(JSRuntime);
                dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

                await CreateMap();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Initialization caused an exception.");
                await ToastService.ShowError("Initialization caused an exception.");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    #region Map

    private async Task AddControls()
    {
        try
        {
            var items = new List<ControlBase>
            {
                new FullscreenControl(),
                new ZoomControl(),
                new CompassControl(),
                new PitchControl(),
                new ScaleControl(),
                new StyleControl(),
                new TrafficControl(),
                new TrafficLegendControl(),
            };

            await atlasInterop.Controls.Add(map!, items);
            addedControls = items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveControls()
    {
        try
        {
            var items = addedControls?.Select(c => c.Type).ToList();
            await atlasInterop.Controls.Remove(map!, items);
            addedControls = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveControlsByRef()
    {
        try
        {
            var refs = await atlasInterop.Controls.GetControls(map!);
            await atlasInterop.Controls.RemoveControls(map!, refs);

            foreach (var item in refs)
                await item.DisposeAsync();

            addedControls = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            //overrride the default map options (if any) that were set.
            config?.MapOptions = MapExtensions.GetDefaultMapOptions();
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveMap()
    {
        try
        {
            if (map == null)
                return;

            await atlasInterop.Factory.RemoveMap(map);
            map = null;
            addedControls = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await Task.CompletedTask;
        await ToastService.ShowInfo($"MapEvent: {e.Type}");

        var test = e.GetPayloadItem<ErrorPayload>("test");
        Console.WriteLine(test?.BuildMessage());
    }

    #endregion
}
