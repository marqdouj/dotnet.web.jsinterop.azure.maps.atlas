@page "/spatial-simplelayer"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<SimpleLayer> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates a SimpleDataLayer.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
            <FluentSpacer Width="10px" />
            <FluentButton Disabled="@addLayerDisabled" IconStart="@(new Icons.Regular.Size20.Add())" Title="Add Layer" OnClick="@AddLayer" />
            <FluentButton Disabled="@removeLayerDisabled" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Delete Layer" OnClick="@RemoveLayer" />
        </Toolbar>

        <FluentStack Height="100%">
            <FluentListbox Items="options"
                           TOption="OptionInfo"
                           TValue="OptionInfo"
                           OptionText="@(i => i.Name)"
                           SelectedItems="selectedOptions"
                           SelectedItemsChanged="OnSelectedItemsChanged"
                           Multiple="true" />

            <MapContainer MapId="@mapId" />
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapSimpleLayer";
    private const string title = "Spatial - SimpleDataLayer";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration config = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private Map? map;
    private bool mapNotReady => map == null;
    private DataSource? dataSource;
    private SimpleDataLayer? layer;
    private bool addLayerDisabled => mapNotReady || layer != null;
    private bool removeLayerDisabled => mapNotReady || layer == null;
    private readonly List<OptionInfo> options = new();
    private List<OptionInfo> selectedOptions = new();

    protected override void OnInitialized()
    {
        config = Configuration.GetValue(LogLevel.Trace);
        atlasInterop = new(JSRuntime);
        dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

        options.Add(new OptionInfo("Allow Extrusions", nameof(SimpleDataLayerOptions.AllowExtrusions)));
        options.Add(new OptionInfo("Enable Popups", nameof(SimpleDataLayerOptions.EnablePopups)));
        options.Add(new OptionInfo("Show Point Titles", nameof(SimpleDataLayerOptions.ShowPointTitles)));
        options.Add(new OptionInfo("Visible", nameof(SimpleDataLayerOptions.Visible)));

        selectedOptions = options.Where(e => e.Value != nameof(SimpleDataLayerOptions.ShowPointTitles)).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CreateMap();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task AddLayer()
    {
        try
        {
            if (dataSource == null)
            {
                dataSource = new();
                await atlasInterop.Sources.Add(map!, dataSource);

                var options = new SpatialDataReadOptions { ZoomToBBox = false };

                var url = await DataService.Examples.Spatial.GetReadUrl(SpatialGetReadUrl.Choropleth3D);
                await atlasInterop.Spatial.IO.Read(map!, dataSource.Id, url);
                url = await DataService.Examples.Spatial.GetReadUrl(SpatialGetReadUrl.Route66Attractions);
                await atlasInterop.Spatial.IO.Read(map!, dataSource.Id, url);

                var camera = await atlasInterop.Map.GetCamera(map!);
                camera!.Zoom = 3;
                await atlasInterop.Map.SetCamera(map!, camera.ToCameraOptions());
            }
            if (layer == null)
            {
                layer = new() { Source = dataSource.Id, Options = new SimpleDataLayerOptions() { AllowExtrusions = true, EnablePopups = true, ShowPointTitles = false, Visible = true } };
                await atlasInterop.Spatial.Layers.Add(map!, [layer]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveLayer()
    {
        try
        {
            if (layer != null)
            {
                await atlasInterop.Layers.Remove(map!, [layer.Id]);
                layer = null;
            }

            if (dataSource != null)
            {
                await atlasInterop.Sources.DataSource.Clear(map!, [dataSource]);
                await atlasInterop.Sources.Remove(map!, dataSource);
                dataSource = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnSelectedItemsChanged(IEnumerable<OptionInfo> options)
    {
        try
        {
            layer!.OptionsT!.AllowExtrusions = GetOptionInfoValue(options, nameof(SimpleDataLayerOptions.AllowExtrusions));
            layer.OptionsT!.EnablePopups = GetOptionInfoValue(options, nameof(SimpleDataLayerOptions.EnablePopups));
            layer.OptionsT!.ShowPointTitles = GetOptionInfoValue(options, nameof(SimpleDataLayerOptions.ShowPointTitles));
            layer.OptionsT!.Visible = GetOptionInfoValue(options, nameof(SimpleDataLayerOptions.Visible));

            await atlasInterop.Spatial.Layers.SetOptions(map!, layer.Id, layer.Options!);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private static bool GetOptionInfoValue(IEnumerable<OptionInfo> options, string value)
    {
        var info = options.FirstOrDefault(e => e.Value == value);

        return info != null ? true : false;
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            await RemoveLayer();
            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);
    }

    #endregion

    private class OptionInfo(string name, string value)
    {
        public string Name { get; } = name;
        public string Value { get; } = value;
    }
}
