@page "/spatial-simplelayer"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<SimpleLayer> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates reading an XML file into a SimpleDataLayer.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
            <FluentSpacer Width="10px" />
            <FluentButton Disabled="@addLayerDisabled" IconStart="@(new Icons.Regular.Size20.Add())" Title="Add Layer" OnClick="@AddLayer" />
            <FluentButton Disabled="@removeLayerDisabled" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Delete Layer" OnClick="@RemoveLayer" />
        </Toolbar>

        <MapContainer MapId="@mapId" />
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapSimpleLayer";
    private const string title = "Spatial - SimpleDataLayer";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration config = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private Map? map;
    private bool mapNotReady => map == null;
    private DataSource? dataSource;
    private SimpleDataLayer? layer;
    private bool addLayerDisabled => mapNotReady || layer != null;
    private bool removeLayerDisabled => mapNotReady || layer == null;

    protected override void OnInitialized()
    {
        config = Configuration.GetValue(LogLevel.Trace);
        atlasInterop = new(JSRuntime);
        dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CreateMap();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task AddLayer()
    {
        try
        {
            if (dataSource == null)
            {
                dataSource = new();
                await atlasInterop.Sources.Add(map!, dataSource);
                var url = await DataService.Examples.Spatial.GetReadUrl(SpatialGetReadUrl.Route66Attractions);
                await atlasInterop.Spatial.IO.Read(map!, dataSource.Id, url);
            }
            if (layer == null)
            {
                layer = new() { Source = dataSource.Id };
                await atlasInterop.Spatial.Layers.Add(map!, [layer]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveLayer()
    {
        try
        {
            if (layer != null)
            {
                await atlasInterop.Layers.Remove(map!, [layer.Id]);
                layer = null;
            }

            if (dataSource != null)
            {
                await atlasInterop.Sources.DataSource.Clear(map!, [dataSource]);
                await atlasInterop.Sources.Remove(map!, dataSource);
                dataSource = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);
    }

    #endregion
}
