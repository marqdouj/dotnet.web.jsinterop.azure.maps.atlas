@page "/maps-options"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<Design> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page demonstrates changing some of the map style and user interaction options.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
        </Toolbar>
        
        <FluentStack Style="overflow:auto">
            <FluentCard Height="@height" Width="265px" Style="overflow:auto;">
                <FluentText Color="Color.Primary" As="TextTag.H6">Style</FluentText>
                @foreach (var item in styleViewModel.Items)
                {
                    <FluentCheckbox Disabled="@mapNotReady" Tooltip="@item.Tooltip" Label="@item.Label" @bind-Value:get="@item.Value" @bind-Value:set="@((e) => OnStyleOptionsChanged(e, item))" />
                }
                <FluentText Color="Color.Primary" As="TextTag.H6">User Interaction</FluentText>
                @foreach (var item in userViewModel.Items)
                {
                    <FluentCheckbox Disabled="@mapNotReady" Tooltip="@item.Tooltip" Label="@item.Label" @bind-Value:get="@item.Value" @bind-Value:set="@((e) => OnUserOptionsChanged(e, item))" />
                }
            </FluentCard>

            <MapContainer MapId="@mapId" MinWidth="400px"/>
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapOptions";
    private const string title = "Maps - Options";
    private readonly string height = "400px";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration config = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private Map? map;
    private bool mapNotReady => map == null;
    private StyleViewModel styleViewModel = default!;
    private UserInteractionViewModel userViewModel = default!;

    protected override void OnInitialized()
    {
        config = Configuration.GetValue(LogLevel.Trace);
        config.MapOptions = mapOptions;
        mapOptions.Style ??= new();
        mapOptions.UserInteraction ??= new();
        atlasInterop = new(JSRuntime);
        dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

        ResetViewModels();
    }

    private void ResetViewModels()
    {
        styleViewModel = new((StyleOptions?)config.MapOptions?.Style?.Clone() ?? new());
        userViewModel = new((UserInteractionOptions?)config.MapOptions?.UserInteraction?.Clone() ?? new());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CreateMap();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OnStyleOptionsChanged(bool value, BoolPropertyViewModel vm)
    {
        try
        {
            vm.Value = value;
            await atlasInterop.Map.SetStyle(map!, styleViewModel.Options);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task OnUserOptionsChanged(bool value, BoolPropertyViewModel vm)
    {
        try
        {
            vm.Value = value;
            await atlasInterop.Map.SetUserInteraction(map!, userViewModel.Options);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            ResetViewModels();
            await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
            await atlasInterop.Map.SetStyle(map, styleViewModel.Options);
            await atlasInterop.Map.SetUserInteraction(map, userViewModel.Options);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);
    }

    #endregion
}
