@page "/howto-shapes"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<Shapes> Logger
@inject INotificationService ToastService
@inject IMapDataService DataService

<MapPage Title="@title" ShowSummary="@showSummary">
    <HeaderContentPre>
        <HowToHeader/>
    </HeaderContentPre>
    <SummaryContent>
        <HowToInfo Subject="@subject">
            <br /><br />
            NOTE: The <FluentText Color="Color.Primary">GetShapeInfo</FluentText> method works on small sets of data.
            For larger sets of data, request using a smaller specific set of shapeIds or use the <FluentText Color="Color.Primary">ToJson</FluentText> 
            method and save the JSON to file.
        </HowToInfo>
    </SummaryContent>

    <ChildContent>
        <Toolbar>
            <FluentButton Disabled="@mapNotReady" IconStart="@(new Icons.Regular.Size20.ArrowReset())" Title="Reset Map" OnClick="@ResetMap" />
            <FluentLabel>Layer:</FluentLabel>
            <FluentSelect Items="@layerTypes" TValue="LayerType" TOption="LayerType" ValueChanged="@((e) => AddLayer(e))" Placeholder="Select a layer..." />
            <FluentSpacer Width="10px" />
            <FluentButton Disabled="@getShapeInfoDisabled" IconStart="@(new Icons.Regular.Size20.Info())" Title="@getShapeInfoTitle" OnClick="@GetShapeInfo">GetShapeInfo</FluentButton>
            <FluentButton Disabled="@toJsonDisabled" IconStart="@(new Icons.Regular.Size20.Javascript())" Title="@getJsonTitle" OnClick="@GetJsonString">ToJsonString</FluentButton>
        </Toolbar>

        <FluentStack Orientation="Orientation.Vertical">
            <MapContainer MapId="@mapId" Height="250px" MinWidth="400px" />

            @if (shapeInfo != null)
            {
                <div style="max-height:250px; min-width: 400px;overflow:auto">
                    <FluentDataGrid Items="@shapeInfo?.AsQueryable()"
                                    TGridItem="ShapeInfo"
                                    GridTemplateColumns="auto, auto, auto, auto, auto"
                                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                    MultiLine="true">
                        <PropertyColumn Property="@(p => p.Type)" />
                        <PropertyColumn Property="@(p => p.Id)" />
                        <PropertyColumn Property="@(p => p.Center)" />
                        <PropertyColumn Property="@(p => p.Bounds)" />
                        <PropertyColumn Property="@(p => p.Properties.ToJsonMin())" Title="Properties" />
                        <TemplateColumn Title="Actions">
                            <FluentStack>
                                @if (canZoomToShape)
                                {
                                    <FluentButton IconStart="@(new Icons.Regular.Size20.ZoomIn())" Title="@zoomToShapeTitle" OnClick="@(() => ZoomToShape(context))" />
                                }
                                <FluentButton IconStart="@(new Icons.Regular.Size20.Clipboard())" Title="Copy JSON to clipboard" @onclick="@(() => CopyToClipboard(context))" />
                            </FluentStack>
                        </TemplateColumn>
                    </FluentDataGrid>
                </div>
            }

            @if (hasJsonString)
            {
                <FluentText As="TextTag.Paragraph">
                    @jsonString
                </FluentText>
            }
        </FluentStack>
    </ChildContent>
</MapPage>

@code {
    private const string mapId = "mapShapes";
    private const string title = "Shapes";
    private string subject => title; //Customize the subject as needed for the page context
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration config = default!;
    private readonly MapOptions mapOptions = MapExtensions.GetDefaultMapOptions();
    private Map? map;
    private bool mapNotReady => map == null;
    private DataSource? dataSource;
    private ILayer? layer;
    private bool layerNotReady => layer == null;
    private List<ShapeInfo>? shapeInfo;
    private bool getShapeInfoDisabled => layerNotReady;
    private string getShapeInfoTitle = "Gets shape information for a DataSource";
    private string zoomToShapeTitle = "Zoom to the center of the shape";
    private bool toJsonDisabled => layerNotReady;
    private string? jsonString;
    private bool hasJsonString => !string.IsNullOrWhiteSpace(jsonString);
    private string getJsonTitle = "Gets a JSON string reprsentation of the DataSource shapes.";
    private bool showSummary = true;
    private readonly List<LayerType> layerTypes = Enum.GetValues<LayerType>().OrderBy(e => e.ToString()).Cast<LayerType>().ToList();
    private bool canZoomToShape => layer?.Type == LayerType.Symbol;
    protected override void OnInitialized()
    {
        config = Configuration.GetValue(LogLevel.Trace);
        atlasInterop = new(JSRuntime);
        dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);

        // Remove unsupported layer types for this example
        layerTypes.Remove(LayerType.HeatMap); //Data is too large
        layerTypes.Remove(LayerType.Image); // DataSource is not supported
        layerTypes.Remove(LayerType.Tile); // DataSource is not supported
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await CreateMap();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task GetShapeInfo()
    {
        try
        {
            shapeInfo = await atlasInterop.Sources.DataSource.GetShapeInfo(map!, dataSource!);
            showSummary = false;
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task GetJsonString()
    {
        try
        {
            jsonString = await atlasInterop.Sources.DataSource.ToJsonString(map!, dataSource!);
            await CopyToClipboard(jsonString!);
            showSummary = false;
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ZoomToShape(ShapeInfo shapeInfo)
    {
        try
        {
            await atlasInterop.Map.ZoomTo(map!, shapeInfo.Center, 15);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ZoomToDataSource()
    {
        try
        {
            await atlasInterop.Sources.DataSource.ZoomToBBox(map!, dataSource!);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task CopyToClipboard(ShapeInfo shapeInfo)
    {
        await CopyToClipboard(shapeInfo.ToJsonMin());
    }

    private async Task CopyToClipboard(string value)
    {
        try
        {
            var result = await atlasInterop.Navigator.CopyTextToClipboard(value);

            if (!string.IsNullOrWhiteSpace(result.Message))
                await ToastService.ShowInfo(result.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "");
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task AddLayer(LayerType layerType)
    {
        try
        {
            await ClearMap();
            var results = await layerType.AddDefaultLayer(atlasInterop, map!, DataService);
            dataSource = (DataSource)results.Source!;
            layer = results.Layer!;

            await ZoomToDataSource();
            var camera = await atlasInterop.Map.GetCamera(map!);
            mapOptions.Camera = camera.ToCameraOptions();
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }
    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            config.MapOptions = mapOptions;
            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!, MapExtensions.GetDefaultControls());
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ClearMap()
    {
        try
        {
            if (dataSource == null && layer == null)
                return;
            await atlasInterop.Layers.Remove(map!, layer!.Id);
            await atlasInterop.Sources.Remove(map!, dataSource!.Id);
            dataSource = null;
            layer = null;
            shapeInfo = null;
            jsonString = null;
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task ResetMap()
    {
        try
        {
            if (map == null)
                return;

            shapeInfo = null;
            jsonString = null;

            if (dataSource != null)
                await ZoomToDataSource();
            else
                await atlasInterop.Map.SetCamera(map, mapOptions.Camera);
        }
        catch (Exception ex)
        {
            Logger.LogMapError(ex);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await e.ErrorEventProcessed(Logger, ToastService);

        if (e.IsReadyEvent)
        {
            await AddLayer(layerTypes.First());
        }
    }

    #endregion
}
