@page "/howto-summary"
@rendermode InteractiveServer

<MapPage Title="@title">
    <SummaryContent>
        <FluentText As="TextTag.Paragraph">
            This page provides navigation to other pages that demonstrate working with various map objects.
            <br />
            Please select a topic from the tree view.
        </FluentText>
    </SummaryContent>

    <ChildContent>
        <FluentTreeView>
            <FluentTreeItem Text="DataSource" IconStart="@(new Icons.Regular.Size20.DesignIdeas())">
                <FluentTreeItem IconStart="@(new Icons.Regular.Size20.Shapes())">
                    <FluentLink Href="/howto-shapes">Shapes</FluentLink>
                </FluentTreeItem>
            </FluentTreeItem>

            <FluentTreeItem Text="Images" IconStart="@(new Icons.Regular.Size20.DesignIdeas())">
                <FluentTreeItem IconStart="@(new Icons.Regular.Size20.Shapes())">
                    <FluentLink Href="/howto-sprites">Sprites</FluentLink>
                </FluentTreeItem>
            </FluentTreeItem>

            <FluentTreeItem Text="Layers" IconStart="@(new Icons.Regular.Size20.DesignIdeas())">
                <FluentTreeItem IconStart="@(new Icons.Regular.Size20.Shapes())">
                    <FluentLink Href="/howto-layers-vector">Layers (Vector)</FluentLink>
                </FluentTreeItem>
            </FluentTreeItem>
        </FluentTreeView>
    </ChildContent>
</MapPage>

@code {
    private const string title = "How To";
}
