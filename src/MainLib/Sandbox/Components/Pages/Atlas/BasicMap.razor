@page "/map-basic"
@rendermode InteractiveServer
@inject IOptions<MapConfiguration> Configuration
@inject IJSRuntime JSRuntime
@inject ILogger<BasicMap> Logger
@inject INotificationService ToastService

<PageTitle>@title</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Height="100%">
    <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center">
        <FluentButton Disabled="@createMapDisabled" IconStart="@(new Icons.Regular.Size20.Add())" Title="Create Map" OnClick="@CreateMap" />
        <FluentButton Disabled="@removeMapDisabled" IconStart="@(new Icons.Regular.Size20.Delete())" Title="Remove Map" OnClick="@RemoveMap" />
    </FluentStack>

    <MapContainer MapId="@mapId" Height="400px" Width="400px"/>
</FluentStack>

@code {
    private const string mapId = "mapBasic";
    private const string title = "Basic Map";
    private DotNetObjectReference<ComponentBase>? dotNetRef;
    private AtlasInterop atlasInterop = default!;
    private MapConfiguration? config;
    private Map? map;
    private bool hasInterop => atlasInterop != null;
    private bool createMapDisabled => !hasInterop || map != null;
    private bool removeMapDisabled => !hasInterop || map == null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                config = Configuration?.Value;
                var auth = config?.AuthOptions;

                if (config == null)
                    throw new Exception($"Injection of {nameof(MapConfiguration)} returned null.");

                if (auth == null)
                    throw new Exception($"Injection of {nameof(MapConfiguration)}.{nameof(MapConfiguration.AuthOptions)} returned null.");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Map authentication failed.");
                await ToastService.ShowError("Map authentication failed.");
                return;
            }

            try
            {
                if (atlasInterop != null)
                    await atlasInterop.DisposeAsync();
                dotNetRef?.Dispose();

                atlasInterop = new(JSRuntime);
                dotNetRef = DotNetObjectReference.Create<ComponentBase>(this);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Initialization caused an exception.");
                await ToastService.ShowError("Initialization caused an exception.");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            dotNetRef?.Dispose();

            if (map != null)
                await map.DisposeAsync();

            if (atlasInterop != null)
                await atlasInterop.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    #region Map

    private async Task CreateMap()
    {
        try
        {
            if (map != null)
                return;

            map = await atlasInterop.Factory.CreateMap(dotNetRef!, mapId, config!);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    private async Task RemoveMap()
    {
        try
        {
            if (map == null)
                return;

            await atlasInterop.Factory.RemoveMap(map);
            map = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, null);
            await ToastService.ShowError(ex.Message);
        }
    }

    [JSInvokable]
    public async Task NotifyMapEvent(MapEventArgs e)
    {
        await Task.CompletedTask;
        await ToastService.ShowInfo($"MapEvent: {e.Type}");
    }

    #endregion
}
